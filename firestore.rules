rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All access now goes through the backend, which uses the Admin SDK and
    // bypasses these rules. Direct client access is denied, so the farms can
    // only be read or changed via the backend (with the clan password).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
